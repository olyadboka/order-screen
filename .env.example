# Neon Postgres (pooled connection for the app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Neon direct connection (used by prisma migrate). If you don't have one, set it equal to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# 32+ character secret for signing session JWTs. Generate: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
